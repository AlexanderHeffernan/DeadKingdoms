{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "rootDir": ".",
    "outDir": "dist/client",
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "useUnknownInCatchVariables": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["public/js/**/*.ts", "src/shared/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
